# G1 — npm install policy for the viz package (ROADMAP §3 G1).
#
# engines-strict: REQUIRED. Refuses to install when the host Node is
# outside the `engines.node` range in package.json (>= 18 today).
# Without this, an `npm ci` on a Node 16 dev box silently succeeds and
# then the webpack build fails later with a cryptic error.
#
# save-exact: REQUIRED. When a contributor runs `npm install <name>`,
# the resulting package.json entry has NO caret/tilde — the exact
# version is locked. Combined with the committed package-lock.json
# this gives deterministic, audit-friendly installs across CI and
# dev machines. (Caret ranges silently let a `npm install` pull a
# different minor than what was tested.)
#
# audit-level=high: makes ad-hoc `npm install` print a warning on any
# new high+ vulnerability. The hard gate is scripts/check-npm-audit.py
# in CI; this is a developer-experience hint that catches things during
# a local install.
#
# fund=false: silence the donation prompts that npm spams during install.
# We track funding via SBOM ownership; the npm prompt is noise.
#
# loglevel=error: keep `npm ci` output focused on errors only — the
# audit pass and the dep tree are inspected by the dedicated gates.

engines-strict = true
save-exact = true
audit-level = high
fund = false
loglevel = error
