{
  "name": "better-map-viz",
  "version": "1.8.0",
  "private": true,
  "description": "Better Map - Splunk custom map visualization built on MapLibre GL JS",
  "license": "MIT",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "lint": "eslint src/",
    "lint:css-contract": "node ../../../../../scripts/lint-js-css-contract.js",
    "lint:console-noise": "node ../../../../../scripts/check-bundle-console-noise.js",
    "lint:bundle-size": "node ../../../../../scripts/check-bundle-size.js",
    "lint:version-consistency": "node ../../../../../scripts/check-version-consistency.js",
    "lint:appinspect": "bash ../../../../../scripts/run-appinspect-local.sh",
    "lint:appinspect-parity": "python3 ../../../../../scripts/check-rsync-exclude-parity.py",
    "lint:a11y": "node ../../../../../scripts/check-accessibility.js",
    "lint:browser-compat": "node ../../../../../scripts/check-browser-compat.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,css,json}\""
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.3.5",
    "density-clustering": "^1.3.0",
    "dompurify": "^3.4.5",
    "h3-js": "^4.1.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.3",
    "milsymbol": "^3.0.4",
    "pmtiles": "^4.4.1",
    "simple-statistics": "^7.8.9",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@vitest/coverage-v8": "^4.1.6",
    "css-loader": "^7.1.0",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "playwright": "1.60.0",
    "prettier": "^3.4.0",
    "style-loader": "^4.0.0",
    "vitest": "^4.1.6",
    "webpack": "^5.97.0",
    "webpack-cli": "^7.0.2"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
