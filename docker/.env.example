# D5 — local Splunk harness environment.
#
# Copy this file to docker/.env (gitignored) and fill in the values
# below before running `bash docker/scripts/bootstrap.sh`.
#
# Why these are in a `.env` file (not docker-compose defaults):
# The docker-compose.yml uses `${VAR:?...}` to FAIL FAST when a
# required value is missing — that's safer than a default password
# (someone would inevitably ship it). The actual values are operator-
# specific and never belong in git.

# ----------------------------------------------------------------------
# REQUIRED — these will fail-fast the boot if missing
# ----------------------------------------------------------------------

# Admin password for Splunk Enterprise inside the container.
# Constraints (enforced by the splunk/splunk image's first-boot
# ansible playbook):
#   * MINIMUM 8 characters
#   * MUST contain at least one of each: upper, lower, digit, symbol
#   * MUST NOT be "changeme", "password", "admin", or any other
#     dictionary word the image's strength check rejects
# Example (DO NOT REUSE — generate your own):
#   SPLUNK_PASSWORD=Better_Map_Lab_2026!
SPLUNK_PASSWORD=changeme-to-a-real-password

# HEC (HTTP Event Collector) token. UUID4 format. Used by Phase 2.5
# live-data validators and recipe verification work to push synthetic
# events into Splunk indexes via port 8088.
# Generate one with: `python3 -c "import uuid; print(uuid.uuid4())"`
# Example (DO NOT REUSE — generate your own):
#   SPLUNK_HEC_TOKEN=a8e4f2c0-1d3b-4a5e-b7c9-0e1f2a3b4c5d
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------
# OPTIONAL — override defaults if a port collides on your machine
# ----------------------------------------------------------------------

# Splunk Web (UI) port. Default 8000. If you already have a Splunk
# install or another service on 8000, change this here AND in the
# browser URL you visit after bootstrap.
# SPLUNK_WEB_PORT=8000

# splunkd management REST port. Default 8089. The bootstrap script
# and dispatch-test rig connect here; if you change it, the secrets.env
# the bootstrap script writes will reflect the override.
# SPLUNK_MGMT_PORT=8089

# HEC port. Default 8088. Same override rules as the others.
# SPLUNK_HEC_PORT=8088

# Splunk Docker image tag. Default `latest` (matches the mainline
# stable train at the time of bootstrap). Pin to a specific release
# (e.g. `10.2`, `10.3.1`) if you need version-specific behaviour for
# bug reproduction or recipe verification.
# SPLUNK_IMAGE_TAG=latest
