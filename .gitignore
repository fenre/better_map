# =============================================================
# better_map — repository .gitignore
#
# Rule of thumb: track sources, contracts, and final shipped
# artifacts; never track build inputs (node_modules), build
# scratch (dist/, *.tgz, *.tar.gz), or local-user state
# (.DS_Store, .vscode/, .idea/).
#
# package-lock.json IS tracked — it's what reproduces
# node_modules in CI via `npm ci`.
# =============================================================

# -------------------------------------------------------------
# Build inputs (reproducible via lockfile; never commit)
# -------------------------------------------------------------
node_modules/
**/node_modules/

# -------------------------------------------------------------
# Build outputs and packaging artifacts
# -------------------------------------------------------------
# Release tarballs live in dist/ during local packaging.
# Splunkbase pulls signed tarballs from GitHub Releases (G1/G2).
dist/
*.tgz
*.tar.gz
*.spl

# Per-engineer local installs of build tools
.husky/_/

# -------------------------------------------------------------
# Operating-system and editor cruft
# -------------------------------------------------------------
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/
.aider*
.windsurfrc

# -------------------------------------------------------------
# Logs and runtime files
# -------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# -------------------------------------------------------------
# Local-only credentials and environment files
# -------------------------------------------------------------
.env
.env.*
!.env.example
secrets.env
*.pem
*.key

# -------------------------------------------------------------
# Test coverage and reports (regenerable per CI run)
# -------------------------------------------------------------
coverage/
.nyc_output/
reports/
test-results/
playwright-report/
playwright/.cache/

# -------------------------------------------------------------
# Webpack / build caches
# -------------------------------------------------------------
.webpack-cache/
.cache/
.parcel-cache/
.eslintcache

# -------------------------------------------------------------
# Splunk local-state (NEVER ship; AppInspect rejects)
# -------------------------------------------------------------
**/local/
**/metadata/local.meta

# -------------------------------------------------------------
# AppInspect local helper (G2-2): venv + per-run staging
# -------------------------------------------------------------
.venv-appinspect/
dist-appinspect/
dist-appinspect-local/

# -------------------------------------------------------------
# MkDocs (E2): build artefacts and the local-only Python venv.
# `site/` is the rendered HTML output (`mkdocs build`), GitHub
# Pages-deployed by `.github/workflows/docs.yml` straight off
# CI — never committed. `.venv-mkdocs/` is a maintainer
# convenience for `mkdocs serve` previews; CI uses an
# ephemeral venv each run.
# -------------------------------------------------------------
site/
.venv-mkdocs/

# -------------------------------------------------------------
# D5 — Local Splunk harness (docker/docker-compose.yml).
# `docker/.env` carries the operator's admin password + HEC
# token; never commit. `docker/staging/` holds the freshly-
# built app tarball bind-mounted into the Splunk container
# at install time; regenerated every bootstrap run.
# -------------------------------------------------------------
docker/.env
docker/staging/
