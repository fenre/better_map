# =============================================================
# better_map — repository .gitignore
#
# Rule of thumb: track sources, contracts, and final shipped
# artifacts; never track build inputs (node_modules), build
# scratch (dist/, *.tgz, *.tar.gz), or local-user state
# (.DS_Store, .vscode/, .idea/).
#
# package-lock.json IS tracked — it's what reproduces
# node_modules in CI via `npm ci`.
# =============================================================

# -------------------------------------------------------------
# Build inputs (reproducible via lockfile; never commit)
# -------------------------------------------------------------
node_modules/
**/node_modules/

# -------------------------------------------------------------
# Build outputs and packaging artifacts
# -------------------------------------------------------------
# Release tarballs live in dist/ during local packaging.
# Splunkbase pulls signed tarballs from GitHub Releases (G1/G2).
dist/
*.tgz
*.tar.gz
*.spl

# Per-engineer local installs of build tools
.husky/_/

# -------------------------------------------------------------
# Operating-system and editor cruft
# -------------------------------------------------------------
.DS_Store
**/.DS_Store
._*
**/._*
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.cursor/
.aider*
.windsurfrc

# -------------------------------------------------------------
# Logs and runtime files
# -------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# -------------------------------------------------------------
# Local-only credentials and environment files
# -------------------------------------------------------------
.env
.env.*
!.env.example
secrets.env
*.pem
*.key

# -------------------------------------------------------------
# Test coverage and reports (regenerable per CI run)
# -------------------------------------------------------------
coverage/
.nyc_output/
reports/
test-results/
playwright-report/
playwright/.cache/

# -------------------------------------------------------------
# Webpack / build caches
# -------------------------------------------------------------
.webpack-cache/
.cache/
.parcel-cache/
.eslintcache

# -------------------------------------------------------------
# Splunk local-state (NEVER ship; AppInspect rejects)
# -------------------------------------------------------------
**/local/
**/metadata/local.meta
